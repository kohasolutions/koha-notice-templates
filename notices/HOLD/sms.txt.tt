[%-
  # ── Your library: change the value on this line only. ──────────────────────────────────────────────────
  library_name = branch.branchname;  # leave it like this to use the library name you have in Koha
-%]
[% library_name %]: your reserved item is ready to collect: [% biblio.title | $Remove_MARC_punctuation | trim | truncate(40) %].[% IF hold.expirationdate %] Please collect it by [% hold.expirationdate | $KohaDates %].[% END %]
