[%-
  # ── Your library: change the values on these two lines only. ───────────────────────────────────────────
  library_name = branch.branchname;  # leave it like this to use the library name you have in Koha
  footer_note  = "";                 # one line under the signature, e.g. your opening hours; "" = none
  USE Koha;
-%]
[% IF borrower.firstname %]Dear [% borrower.firstname %],[% ELSE %]Hello,[% END %]

[% IF checkouts.size == 1 %]This item is due back today. Please return or renew it by the end of the day so that it does not become overdue.[% ELSE %]These [% checkouts.size %] items are due back today. Please return or renew them by the end of the day so that they do not become overdue.[% END %]

[% FOREACH checkout IN checkouts -%]
* [% checkout.title | $Remove_MARC_punctuation | trim %][% IF checkout.author %], [% checkout.author | $Remove_MARC_punctuation | trim %][% END %]
  Due [% checkout.date_due | $KohaDates %] · Barcode [% checkout.barcode %]

[% END -%]
[% IF Koha.Preference('OPACBaseURL') -%]
See your loans and renew them online: [% Koha.Preference('OPACBaseURL') %]/cgi-bin/koha/opac-user.pl

[% END -%]
Thank you,
[% library_name %]
[% IF footer_note %][% footer_note %][% END %]
